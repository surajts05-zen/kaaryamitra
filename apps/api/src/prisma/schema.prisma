// KaaryaMitra HRMS — Prisma Schema
// Multi-tenant SaaS: every business entity carries tenantId

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum TenantPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_SETUP
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  OFFBOARDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum LeaveApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum AttendanceCaptureSource {
  WEB_QR
  WEB_BUTTON
  MOBILE_QR
  API_PUSH
  BIOMETRIC
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum WorkflowStepType {
  APPROVAL
  NOTIFICATION
  ACTION
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  ESCALATED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkflowTriggerType {
  LEAVE_REQUEST
  EXPENSE_REQUEST
  OFFBOARDING_REQUEST
  DOCUMENT_REQUEST
  ATTENDANCE_REGULARIZATION
  TIMESHEET_APPROVAL
  SHIFT_SWAP_REQUEST
  CUSTOM
  ONBOARDING_WORKFLOW
  ASSET_REQUEST
  RESIGNATION_APPROVAL
  COMPENSATION_REVISION
  PAYROLL_APPROVAL
  BUDGET_REQUEST
}

enum ShiftType {
  FIXED
  FLEXIBLE
  ROTATING
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum WorkflowAssigneeType {
  MANAGER
  DEPARTMENT_HEAD
  ROLE
  SPECIFIC_USER
  HR
}

enum DocumentStatus {
  VALID
  EXPIRED
  ARCHIVED
}

enum ClearanceMode {
  SIMPLE
  CHECKLIST
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  LOST
  RETIRED
}

enum AssetAssignmentStatus {
  PENDING_ACKNOWLEDGEMENT
  ACKNOWLEDGED
  RETURNED
}

enum TaskType {
  ONBOARDING
  OFFBOARDING
}

enum TaskStatus {
  PENDING
  COMPLETED
  NOT_APPLICABLE
}

enum ResignationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
  EMPLOYEE_CONTRIBUTION
}

enum SalaryComponentFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
}

enum CompensationRevisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  REVIEW
  APPROVED
  FINALIZED
  PAID
}

enum PayrollLineItemType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
  TAX
  STATUTORY
}

// ─────────────────────────────────────────────────────────────────────────────
// PERFORMANCE MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

enum GoalType {
  OKR
  KPI
  SMART_GOAL
}

enum GoalStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  COMPLETED
}

enum ReviewCycleType {
  ANNUAL
  BIANNUAL
  QUARTERLY
  PROBATION
  AD_HOC
}

enum ReviewStatus {
  NOT_STARTED
  SELF_EVALUATION
  MANAGER_EVALUATION
  PEER_EVALUATION
  HR_REVIEW
  COMPLETED
}

enum FeedbackType {
  PEER
  SUBORDINATE
  MANAGER
}

// ─────────────────────────────────────────────────────────────────────────────
// PROJECTS & BUDGET MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  PROPOSED
  APPROVED
  ACTIVE
  ON_HOLD
  AT_RISK
  COMPLETED
  CANCELLED
  CLOSED
}

enum BudgetRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ALLOCATED
  PARTIALLY_RELEASED
  FULLY_RELEASED
  ACTIVE
  CLOSED
  REJECTED
  CANCELLED
  EXPIRED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  COMPLETED
  DELAYED
  CANCELLED
}

enum BudgetTransactionType {
  INITIAL_ALLOCATION
  FUNDING_RELEASE
  EXPENSE
  COMMITMENT
  REALLOCATION_OUT
  REALLOCATION_IN
  REVISION_INCREASE
  REVISION_DECREASE
  ADJUSTMENT
  REVERSAL
}

enum FundingReleaseStatus {
  REQUESTED
  APPROVED
  RELEASED
  PARTIALLY_RELEASED
  REJECTED
  CANCELLED
}

enum CapexOpex {
  CAPEX
  OPEX
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique // /t/{slug}/ routing
  status TenantStatus @default(TRIAL)
  plan   TenantPlan   @default(FREE)

  // Branding
  logoUrl      String?
  logoUrlDark  String?
  faviconUrl   String?
  primaryColor String? // hex e.g. #A8E600
  accentColor  String?

  // Domain
  domain String? @unique

  // Feature flags (JSON map: featureName -> boolean)
  // Rebuilt by BillingService.syncFeatureFlags() after subscription changes
  featureFlags Json @default("{}")

  // AI Config
  geminiApiKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                  User[]
  departments            Department[]
  teams                  Team[]
  locations              Location[]
  designations           Designation[]
  employees              Employee[]
  leaveTypes             LeaveType[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  roles                  Role[]
  workflowTemplates      WorkflowTemplate[]
  jobLevels              JobLevel[]
  holidays               Holiday[]
  companySettings        CompanySettings?
  shifts                 Shift[]
  documentCategories     DocumentCategory[]
  documents              Document[]
  assetCategories        AssetCategory[]
  assets                 Asset[]
  checklistTemplates     ChecklistTemplate[]
  employeeChecklists     EmployeeChecklist[]
  resignations           Resignation[]
  helpdeskCategories     HelpdeskCategory[]
  helpdeskTickets        HelpdeskTicket[]
  AssetAssignment        AssetAssignment[]
  goals                  Goal[]
  reviewCycles           ReviewCycle[]
  performanceReviews     PerformanceReview[]
  salaryComponents       SalaryComponent[]
  salaryStructures       SalaryStructure[]
  compensationProfiles   CompensationProfile[]
  compensationHistory    CompensationHistory[]
  payrollRuns            PayrollRun[]
  statutoryRules         StatutoryRule[]
  policyCategories       PolicyCategory[]
  policies               Policy[]
  policyVersions         PolicyVersion[]
  policyAcknowledgements PolicyAcknowledgement[]
  LibraryFolder          LibraryFolder[]
  LibraryItem            LibraryItem[]
  savedReports           SavedReport[]
  payrollSettings        PayrollSettings?

  costCenters        CostCenter[]
  budgetCategories   BudgetCategory[]
  budgetPeriods      BudgetPeriod[]
  projects           Project[]
  budgetRequests     BudgetRequest[]
  projectExpenses    ProjectExpense[]
  budgetTransactions BudgetTransaction[]
  
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  integrations       TenantIntegration[]
  encryptedSecrets   EncryptedSecret[]

  // Phase 24 — SaaS Billing
  subscription TenantSubscription?
  invoices     Invoice[]
  usageRecords UsageRecord[]

  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  tenantId     String? // null = Super Admin (platform-level)
  email        String       @unique
  firstName    String
  lastName     String
  avatarUrl    String?
  status       UserStatus   @default(PENDING_SETUP)
  authProvider AuthProvider @default(LOCAL)
  isSuperAdmin Boolean      @default(false)

  // LOCAL auth
  passwordHash           String?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  // GOOGLE auth
  googleId String? @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  tenant            Tenant?           @relation(fields: [tenantId], references: [id])
  employee          Employee? // 1-to-1: user <-> employee record
  sessions          Session[]
  userRoles         UserRole[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  verifiedDocs      Document[]        @relation("DocumentVerifier")
  uploadedDocs      DocumentVersion[] @relation("DocumentUploader")
  publishedPolicies PolicyVersion[]   @relation("PolicyPublisher")
  LibraryFolder     LibraryFolder[]
  LibraryItem       LibraryItem[]
  apiKeys           ApiKey[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id          String  @id @default(cuid())
  tenantId    String? // null = platform-level role (Super Admin)
  name        String
  description String?
  isSystem    Boolean @default(false) // System roles cannot be deleted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  action      String @unique // e.g. 'employee:create'
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String
  roleId    String
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String?
  headId   String? // Employee FK added after Employee model
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  head      Employee?    @relation("DepartmentHead", fields: [headId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  employees Employee[]
  teams     Team[]
  goals     Goal[]

  @@unique([tenantId, name])
  @@map("departments")
}

model Team {
  id           String  @id @default(cuid())
  tenantId     String
  departmentId String?
  name         String
  leadId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  lead       Employee?   @relation("TeamLead", fields: [leadId], references: [id])
  employees  Employee[]

  @@unique([tenantId, name])
  @@map("teams")
}

model Location {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  address  String?
  city     String?
  state    String?
  country  String?
  timezone String  @default("Asia/Kolkata")
  // Geofencing
  lat      Float?
  lon      Float?
  radius   Int?    @default(200) // metres

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  employees Employee[]
  qrCodes   AttendanceQrCode[]
  holidays  Holiday[]

  @@map("locations")
}

model Designation {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  level    String? // e.g. L3, Senior, Principal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@unique([tenantId, name])
  @@map("designations")
}

model JobLevel {
  id       String @id @default(cuid())
  tenantId String
  name     String // e.g. "L1", "Manager", "Director"
  rank     Int? // for sorting, e.g. 10 for L1, 20 for L2

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@unique([tenantId, name])
  @@map("job_levels")
}

model Holiday {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String? // if null, applies to all locations
  name       String
  date       DateTime @db.Date
  type       String // e.g. "PUBLIC", "OPTIONAL"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@map("holidays")
}

model CompanySettings {
  id                    String        @id @default(cuid())
  tenantId              String        @unique
  workingDays           Json          @default("[1,2,3,4,5]") // array of 0-6 (Sun-Sat)
  workHoursStart        String        @default("09:00")
  workHoursEnd          String        @default("18:00")
  probationDays         Int           @default(90)
  timezone              String        @default("Asia/Kolkata")
  isAttendanceEnabled   Boolean       @default(true)
  isGeolocationEnforced Boolean       @default(false)
  isTimesheetEnabled    Boolean       @default(true)
  clearanceMode         ClearanceMode @default(SIMPLE)
  currency              String        @default("USD")

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("company_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSETS (Phase 13)
// ─────────────────────────────────────────────────────────────────────────────
model AssetCategory {
  id       String @id @default(cuid())
  tenantId String
  name     String

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  assets Asset[]

  @@map("asset_categories")
}

model Asset {
  id                 String      @id @default(cuid())
  tenantId           String
  categoryId         String
  name               String
  serialNumber       String?
  assetTag           String?
  purchaseDate       DateTime?
  warrantyExpiryDate DateTime?
  status             AssetStatus @default(AVAILABLE)
  customFields       Json        @default("{}")

  assignedToId String?
  assignedAt   DateTime?

  category    AssetCategory     @relation(fields: [categoryId], references: [id])
  assignedTo  Employee?         @relation(fields: [assignedToId], references: [id])
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  assignments AssetAssignment[]

  @@map("assets")
}

model AssetAssignment {
  id              String                @id @default(cuid())
  tenantId        String
  assetId         String
  employeeId      String
  assignedById    String
  status          AssetAssignmentStatus @default(PENDING_ACKNOWLEDGEMENT)
  assignedAt      DateTime              @default(now())
  acknowledgedAt  DateTime?
  returnedAt      DateTime?
  returnCondition String?
  notes           String?

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  asset            Asset             @relation(fields: [assetId], references: [id])
  employee         Employee          @relation("AssetAssignee", fields: [employeeId], references: [id])
  assignedBy       Employee          @relation("AssetAssignedBy", fields: [assignedById], references: [id])
  workflowInstance WorkflowInstance?

  @@map("asset_assignments")
}

// ─────────────────────────────────────────────────────────────────────────────
// PERFORMANCE (Phase 16)
// ─────────────────────────────────────────────────────────────────────────────

model Goal {
  id          String     @id @default(cuid())
  tenantId    String
  title       String
  description String?
  type        GoalType   @default(SMART_GOAL)
  status      GoalStatus @default(NOT_STARTED)
  progress    Int        @default(0) // 0-100%
  startDate   DateTime
  dueDate     DateTime

  parentGoalId String?
  employeeId   String?
  departmentId String?
  companyWide  Boolean @default(false)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  parentGoal Goal?       @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  childGoals Goal[]      @relation("GoalHierarchy")
  employee   Employee?   @relation("EmployeeGoals", fields: [employeeId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("goals")
}

model ReviewCycle {
  id          String          @id @default(cuid())
  tenantId    String
  title       String
  type        ReviewCycleType
  status      String          @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, CLOSED
  startDate   DateTime
  endDate     DateTime
  is360Degree Boolean         @default(false)

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  reviews PerformanceReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("review_cycles")
}

model PerformanceReview {
  id            String       @id @default(cuid())
  tenantId      String
  reviewCycleId String
  employeeId    String
  status        ReviewStatus @default(NOT_STARTED)

  selfRating      Int? // 1-5 scale
  selfComments    String?
  selfSubmittedAt DateTime?

  managerRating      Int? // 1-5 scale
  managerComments    String?
  managerSubmittedAt DateTime?

  hrComments  String?
  finalRating Int?

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  reviewCycle ReviewCycle      @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  employee    Employee         @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  feedbacks   ReviewFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reviewCycleId, employeeId])
  @@map("performance_reviews")
}

model ReviewFeedback {
  id                  String       @id @default(cuid())
  performanceReviewId String
  reviewerId          String
  type                FeedbackType @default(PEER)
  rating              Int? // 1-5 scale
  comments            String
  isAnonymous         Boolean      @default(true)
  submittedAt         DateTime     @default(now())

  review   PerformanceReview @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  reviewer Employee          @relation("ReviewFeedbacksProvided", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([performanceReviewId, reviewerId])
  @@map("review_feedbacks")
}

// ─────────────────────────────────────────────────────────────────────────────
// ONBOARDING & OFFBOARDING (Phase 13)
// ─────────────────────────────────────────────────────────────────────────────
model ChecklistTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  type        TaskType
  description String?

  tasks  ChecklistTaskTemplate[]
  tenant Tenant                  @relation(fields: [tenantId], references: [id])

  @@map("checklist_templates")
}

model ChecklistTaskTemplate {
  id           String  @id @default(cuid())
  templateId   String
  title        String
  description  String?
  assigneeRole String? // HR, IT, MANAGER, EMPLOYEE

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("checklist_task_templates")
}

model EmployeeChecklist {
  id         String     @id @default(cuid())
  tenantId   String
  employeeId String
  type       TaskType
  status     TaskStatus @default(PENDING)

  tasks EmployeeChecklistTask[]

  employee Employee @relation(fields: [employeeId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@map("employee_checklists")
}

model EmployeeChecklistTask {
  id           String     @id @default(cuid())
  checklistId  String
  title        String
  description  String?
  assigneeRole String?
  status       TaskStatus @default(PENDING)
  completedAt  DateTime?

  checklist EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@map("employee_checklist_tasks")
}

model Resignation {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String

  status                  ResignationStatus @default(PENDING)
  reason                  String?
  submittedAt             DateTime          @default(now())
  requestedLastWorkingDay DateTime

  approvedLastWorkingDay DateTime?
  noticePeriodDays       Int?

  exitInterviewNotes   String?
  isClearanceCompleted Boolean @default(false)

  employee         Employee          @relation(fields: [employeeId], references: [id])
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  workflowInstance WorkflowInstance?

  @@map("resignations")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMPLOYEE
// ─────────────────────────────────────────────────────────────────────────────

model Employee {
  id           String  @id @default(cuid())
  tenantId     String
  userId       String  @unique
  employeeCode String?

  // Personal
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  gender        Gender?
  nationality   String?
  maritalStatus String?
  personalEmail String?
  phone         String?

  // Work
  workEmail        String
  departmentId     String?
  teamId           String?
  locationId       String?
  designationId    String?
  managerId        String? // Self-referential FK
  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(PROBATION)
  joiningDate      DateTime
  confirmationDate DateTime?
  probationEndDate DateTime?
  exitDate         DateTime?

  // Avatar
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])
  department             Department?             @relation(fields: [departmentId], references: [id])
  team                   Team?                   @relation(fields: [teamId], references: [id])
  location               Location?               @relation(fields: [locationId], references: [id])
  designation            Designation?            @relation(fields: [designationId], references: [id])
  jobLevelId             String?
  jobLevel               JobLevel?               @relation(fields: [jobLevelId], references: [id])
  manager                Employee?               @relation("ManagerReportees", fields: [managerId], references: [id])
  reportees              Employee[]              @relation("ManagerReportees")
  departmentHeads        Department[]            @relation("DepartmentHead")
  teamLeads              Team[]                  @relation("TeamLead")
  leaveApplications      LeaveApplication[]
  leaveBalances          LeaveBalance[]
  assets                 Asset[]
  assignedAssets         AssetAssignment[]       @relation("AssetAssignee")
  assetsAssignedByMe     AssetAssignment[]       @relation("AssetAssignedBy")
  checklists             EmployeeChecklist[]
  resignations           Resignation[]
  attendanceRecords      AttendanceRecord[]
  notifications          Notification[]          @relation("EmployeeNotifications")
  employeeShifts         EmployeeShift[]
  timesheets             Timesheet[]
  requestedSwaps         ShiftSwapRequest[]      @relation("RequestedSwaps")
  targetSwaps            ShiftSwapRequest[]      @relation("TargetSwaps")
  documents              Document[]
  requestedTickets       HelpdeskTicket[]        @relation("RequestedTickets")
  assignedTickets        HelpdeskTicket[]        @relation("AssignedTickets")
  goals                  Goal[]                  @relation("EmployeeGoals")
  performanceReviews     PerformanceReview[]     @relation("EmployeeReviews")
  feedbacksProvided      ReviewFeedback[]        @relation("ReviewFeedbacksProvided")
  helpdeskComments       HelpdeskComment[]
  compensationProfile    CompensationProfile?
  compensationHistory    CompensationHistory[]
  payrollEntries         PayrollEntry[]
  policyAcknowledgements PolicyAcknowledgement[]
  workflowInstance       WorkflowInstance?

  @@index([tenantId])
  @@index([managerId])
  @@map("employees")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAVE
// ─────────────────────────────────────────────────────────────────────────────

model LeaveType {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  code        String
  color       String? @default("#4CAF50")
  isPaid      Boolean @default(true)
  isActive    Boolean @default(true)
  description String?

  daysPerYear           Float   @default(0)
  accrualFrequency      String  @default("YEARLY") // 'YEARLY' | 'MONTHLY'
  isCarryForwardAllowed Boolean @default(false)
  maxCarryForward       Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  applications LeaveApplication[]
  balances     LeaveBalance[]

  @@unique([tenantId, code])
  @@map("leave_types")
}

model LeaveApplication {
  id            String                 @id @default(cuid())
  tenantId      String
  employeeId    String
  leaveTypeId   String
  startDate     DateTime
  endDate       DateTime
  isHalfDay     Boolean                @default(false)
  halfDayPeriod String? // 'FIRST_HALF' | 'SECOND_HALF'
  totalDays     Float
  reason        String?
  status        LeaveApplicationStatus @default(PENDING)
  approverNote  String?
  managerNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee         Employee          @relation(fields: [employeeId], references: [id])
  leaveType        LeaveType         @relation(fields: [leaveTypeId], references: [id])
  workflowInstance WorkflowInstance?

  @@index([tenantId, employeeId])
  @@map("leave_applications")
}

model LeaveBalance {
  id          String @id @default(cuid())
  tenantId    String
  employeeId  String
  leaveTypeId String
  year        Int

  totalAccrued Float @default(0)
  used         Float @default(0)
  available    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId, employeeId])
  @@map("leave_balances")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────────

model AttendanceQrCode {
  id         String    @id @default(cuid())
  locationId String
  token      String    @unique @default(cuid())
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  location Location @relation(fields: [locationId], references: [id])

  @@map("attendance_qr_codes")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  WFH
  ON_DUTY
}

model AttendanceRecord {
  id            String                  @id @default(cuid())
  tenantId      String
  employeeId    String
  date          DateTime                @db.Date
  captureSource AttendanceCaptureSource @default(WEB_BUTTON)

  status AttendanceStatus @default(PRESENT)

  punchInTime       DateTime?
  punchInLat        Float?
  punchInLon        Float?
  punchInIp         String?
  punchInImageUrl   String?
  punchInLocationId String?

  punchOutTime       DateTime?
  punchOutLat        Float?
  punchOutLon        Float?
  punchOutIp         String?
  punchOutImageUrl   String?
  punchOutLocationId String?

  totalMinutes      Int?
  totalBreakMinutes Int  @default(0)

  isWfh       Boolean @default(false)
  isOnDuty    Boolean @default(false)
  isLate      Boolean @default(false)
  isEarlyExit Boolean @default(false)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee               @relation(fields: [employeeId], references: [id])
  breaks      AttendanceBreak[]
  corrections AttendanceCorrection[]

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@map("attendance_records")
}

model AttendanceBreak {
  id                 String    @id @default(cuid())
  attendanceRecordId String
  startAt            DateTime
  endAt              DateTime?
  durationMinutes    Int       @default(0)
  type               String    @default("BREAK") // e.g. LUNCH, TEA, OTHER

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  record AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId])
  @@map("attendance_breaks")
}

model AttendanceCorrection {
  id                 String    @id @default(cuid())
  attendanceRecordId String
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  reason             String
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED
  workflowInstanceId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  record           AttendanceRecord  @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  workflowInstance WorkflowInstance?

  @@index([attendanceRecordId])
  @@map("attendance_corrections")
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKFLOW ENGINE
// ─────────────────────────────────────────────────────────────────────────────

model WorkflowTemplate {
  id          String              @id @default(cuid())
  tenantId    String
  name        String
  description String?
  triggerType WorkflowTriggerType @default(CUSTOM)
  entityType  String // e.g. 'LeaveApplication'
  isActive    Boolean             @default(true)
  // JSON array of WorkflowStepDef: [{stepOrder, assigneeType, assigneeId?, label}]
  steps       Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  instances WorkflowInstance[]

  @@unique([tenantId, triggerType])
  @@map("workflow_templates")
}

model WorkflowInstance {
  id                     String         @id @default(cuid())
  tenantId               String
  templateId             String
  entityType             String
  entityId               String
  status                 WorkflowStatus @default(PENDING)
  currentStepIndex       Int            @default(0)
  completedAt            DateTime?
  leaveApplicationId     String?        @unique
  attendanceCorrectionId String?        @unique
  timesheetId            String?        @unique
  shiftSwapRequestId     String?        @unique
  targetEmployeeId       String?        @unique
  resignationId          String?        @unique
  assetAssignmentId      String?        @unique
  compensationHistoryId  String?        @unique
  payrollRunId           String?        @unique
  budgetRequestId        String?        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template             WorkflowTemplate      @relation(fields: [templateId], references: [id])
  leaveApplication     LeaveApplication?     @relation(fields: [leaveApplicationId], references: [id])
  attendanceCorrection AttendanceCorrection? @relation(fields: [attendanceCorrectionId], references: [id])
  timesheet            Timesheet?            @relation(fields: [timesheetId], references: [id])
  shiftSwapRequest     ShiftSwapRequest?     @relation(fields: [shiftSwapRequestId], references: [id])
  targetEmployee       Employee?             @relation(fields: [targetEmployeeId], references: [id])
  resignation          Resignation?          @relation(fields: [resignationId], references: [id])
  assetAssignment      AssetAssignment?      @relation(fields: [assetAssignmentId], references: [id])
  compensationHistory  CompensationHistory?  @relation(fields: [compensationHistoryId], references: [id])
  payrollRun           PayrollRun?           @relation(fields: [payrollRunId], references: [id])
  budgetRequest        BudgetRequest?        @relation(fields: [budgetRequestId], references: [id])
  actions              WorkflowAction[]

  @@map("workflow_instances")
}

model WorkflowAction {
  id         String   @id @default(cuid())
  instanceId String
  stepIndex  Int
  actorId    String
  action     String // 'approved' | 'rejected' | 'delegated'
  comment    String?
  createdAt  DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id])

  @@map("workflow_actions")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id         String              @id @default(cuid())
  tenantId   String
  userId     String
  employeeId String?
  type       String // e.g. 'leave.approved'
  title      String
  body       String
  link       String?
  channel    NotificationChannel @default(IN_APP)
  readAt     DateTime?
  createdAt  DateTime            @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  employee Employee? @relation("EmployeeNotifications", fields: [employeeId], references: [id])

  @@index([userId, readAt])
  @@index([tenantId])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String
  actorEmail String
  action     String // e.g. 'employee.created'
  entityType String // e.g. 'Employee'
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User    @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// SHIFTS & TIMESHEETS
// ─────────────────────────────────────────────────────────────────────────────

model Shift {
  id                 String    @id @default(cuid())
  tenantId           String
  name               String
  startTime          String // e.g., "09:00"
  endTime            String // e.g., "17:00"
  type               ShiftType @default(FIXED)
  gracePeriodMinutes Int       @default(15)
  color              String?   @default("#4CAF50")
  isActive           Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  employeeShifts EmployeeShift[]

  @@unique([tenantId, name])
  @@map("shifts")
}

model EmployeeShift {
  id            String    @id @default(cuid())
  tenantId      String
  employeeId    String
  shiftId       String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@index([tenantId, employeeId])
  @@map("employee_shifts")
}

model Timesheet {
  id              String          @id @default(cuid())
  tenantId        String
  employeeId      String
  periodStartDate DateTime        @db.Date
  periodEndDate   DateTime        @db.Date
  status          TimesheetStatus @default(DRAFT)
  totalHours      Float           @default(0)
  totalOvertime   Float           @default(0)

  submittedAt  DateTime?
  approverNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workflowInstance WorkflowInstance?
  entries          TimesheetEntry[]

  @@unique([tenantId, employeeId, periodStartDate, periodEndDate])
  @@map("timesheets")
}

model TimesheetEntry {
  id            String   @id @default(cuid())
  timesheetId   String
  date          DateTime @db.Date
  hours         Float    @default(0)
  overtimeHours Float    @default(0)
  description   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@unique([timesheetId, date])
  @@map("timesheet_entries")
}

model ShiftSwapRequest {
  id                   String   @id @default(cuid())
  tenantId             String
  requestingEmployeeId String
  targetEmployeeId     String
  date                 DateTime @db.Date
  status               String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestingEmployee Employee          @relation("RequestedSwaps", fields: [requestingEmployeeId], references: [id])
  targetEmployee     Employee          @relation("TargetSwaps", fields: [targetEmployeeId], references: [id])
  workflowInstance   WorkflowInstance?

  @@map("shift_swap_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────────────────────────────────────

model DocumentCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // e.g., "ID Proof", "Address Proof"
  description String?
  isRequired  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  documents Document[]

  @@unique([tenantId, name])
  @@map("document_categories")
}

model Document {
  id          String         @id @default(cuid())
  tenantId    String
  employeeId  String
  categoryId  String
  title       String
  description String?
  status      DocumentStatus @default(VALID)

  // File details of current active version
  fileUrl  String
  fileType String
  fileSize Int

  expiresAt    DateTime? @db.Date
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category DocumentCategory  @relation(fields: [categoryId], references: [id])
  verifier User?             @relation("DocumentVerifier", fields: [verifiedById], references: [id])
  versions DocumentVersion[]

  @@index([tenantId, employeeId])
  @@map("documents")
}

model DocumentVersion {
  id         String  @id @default(cuid())
  documentId String
  version    Int     @default(1)
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedBy String
  changeNote String?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploader User     @relation("DocumentUploader", fields: [uploadedBy], references: [id])

  @@index([documentId])
  @@map("document_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// HELPDESK (Phase 14)
// ─────────────────────────────────────────────────────────────────────────────

model HelpdeskCategory {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?

  // SLAs (in hours) based on priority
  slaLowHours    Int @default(72)
  slaMediumHours Int @default(48)
  slaHighHours   Int @default(24)
  slaUrgentHours Int @default(4)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  tickets HelpdeskTicket[]

  @@unique([tenantId, name])
  @@map("helpdesk_categories")
}

model HelpdeskTicket {
  id           String  @id @default(cuid())
  tenantId     String
  employeeId   String // Requester
  assignedToId String? // Assignee
  categoryId   String

  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  attachments Json @default("[]") // Array of S3 keys or URLs

  slaDeadline DateTime?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee          @relation("RequestedTickets", fields: [employeeId], references: [id])
  assignedTo Employee?         @relation("AssignedTickets", fields: [assignedToId], references: [id])
  category   HelpdeskCategory  @relation(fields: [categoryId], references: [id])
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  comments   HelpdeskComment[]

  @@map("helpdesk_tickets")
}

model HelpdeskComment {
  id       String @id @default(cuid())
  ticketId String
  authorId String

  content     String
  attachments Json   @default("[]")

  isInternal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author Employee       @relation(fields: [authorId], references: [id])

  @@map("helpdesk_comments")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM SETTINGS (Super Admin)
// ─────────────────────────────────────────────────────────────────────────────

model PlatformSettings {
  id           String   @id @default("global")
  smtpHost     String?
  smtpPort     Int?     @default(587)
  smtpUser     String?
  smtpPass     String?
  smtpFrom     String?
  geminiApiKey String?

  // Razorpay (Phase 24)
  razorpayKeyId         String?
  razorpayKeySecret     String?
  razorpayWebhookSecret String?

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPENSATION (Phase 28)
// ─────────────────────────────────────────────────────────────────────────────

// Reusable salary component definitions per tenant
model SalaryComponent {
  id          String                   @id @default(cuid())
  tenantId    String
  name        String // "Basic Salary", "HRA", "PF Employer"
  code        String // "BASIC", "HRA", "PF_EMP"
  type        SalaryComponentType
  frequency   SalaryComponentFrequency @default(MONTHLY)
  isTaxable   Boolean                  @default(true)
  isActive    Boolean                  @default(true)
  description String?

  tenant            Tenant                    @relation(fields: [tenantId], references: [id])
  structureItems    SalaryStructureItem[]
  compensationItems CompensationProfileItem[]
  payrollLineItems  PayrollLineItem[]

  @@unique([tenantId, code])
  @@map("salary_components")
}

// Reusable salary structure templates (by grade/designation/department)
model SalaryStructure {
  id          String  @id @default(cuid())
  tenantId    String
  name        String // "L3 Engineer Structure"
  description String?
  isActive    Boolean @default(true)

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  items    SalaryStructureItem[]
  profiles CompensationProfile[]

  @@map("salary_structures")
}

model SalaryStructureItem {
  id              String  @id @default(cuid())
  structureId     String
  componentId     String
  calculationType String  @default("FIXED") // FIXED | PERCENTAGE | FORMULA
  value           Decimal // amount or percentage
  percentageBase  String? // e.g. "BASIC" for HRA = 40% of Basic
  formula         String?

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id])

  @@map("salary_structure_items")
}

// Per-employee active compensation profile
model CompensationProfile {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId    String   @unique // one active profile per employee
  structureId   String?
  effectiveFrom DateTime
  annualCTC     Decimal
  monthlyGross  Decimal

  // Bank Details
  bankName      String?
  accountNumber String?
  routingNumber String? // IFSC in India
  accountType   String? // Savings / Current

  tenant    Tenant                    @relation(fields: [tenantId], references: [id])
  employee  Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structure SalaryStructure?          @relation(fields: [structureId], references: [id])
  items     CompensationProfileItem[]
  history   CompensationHistory[]

  @@map("compensation_profiles")
}

model CompensationProfileItem {
  id          String  @id @default(cuid())
  profileId   String
  componentId String
  amount      Decimal // computed or overridden monthly amount

  profile   CompensationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  component SalaryComponent     @relation(fields: [componentId], references: [id])

  @@map("compensation_profile_items")
}

// Immutable history — one row per approved revision
model CompensationHistory {
  id            String                     @id @default(cuid())
  tenantId      String
  employeeId    String
  profileId     String
  effectiveDate DateTime
  reason        String
  previousCTC   Decimal?
  newCTC        Decimal
  approvedById  String?
  status        CompensationRevisionStatus @default(DRAFT)

  createdAt DateTime @default(now())

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  profile          CompensationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workflowInstance WorkflowInstance?

  @@map("compensation_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYROLL (Phase 29, 30)
// ─────────────────────────────────────────────────────────────────────────────

// A payroll run for a given period
model PayrollRun {
  id          String        @id @default(cuid())
  tenantId    String
  name        String        @default("Payroll Run")
  period      String // "2026-09" (YYYY-MM)
  periodStart DateTime      @default(now())
  periodEnd   DateTime      @default(now())
  paymentDate DateTime      @default(now())
  frequency   String        @default("MONTHLY") // MONTHLY | BIWEEKLY | WEEKLY
  status      PayrollStatus @default(DRAFT)

  totalGross                 Decimal?
  totalNet                   Decimal?
  totalDeductions            Decimal?
  totalEmployerContributions Decimal?

  processedAt  DateTime?
  approvedAt   DateTime?
  finalizedAt  DateTime?
  paidAt       DateTime?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  entries          PayrollEntry[]
  workflowInstance WorkflowInstance?

  @@unique([tenantId, period, frequency])
  @@map("payroll_runs")
}

// One entry per employee per payroll run
model PayrollEntry {
  id           String @id @default(cuid())
  payrollRunId String
  employeeId   String
  tenantId     String

  grossEarnings         Decimal
  totalDeductions       Decimal
  netPay                Decimal
  employerContributions Decimal @default(0)

  workingDays   Int
  lopDays       Int     @default(0) // Loss of Pay
  overtimeHours Decimal @default(0)

  isFinalized Boolean @default(false) // IMMUTABLE once true

  payrollRun PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee          @relation(fields: [employeeId], references: [id])
  lineItems  PayrollLineItem[]

  @@unique([payrollRunId, employeeId])
  @@map("payroll_entries")
}

// Individual earning/deduction lines per entry
model PayrollLineItem {
  id          String              @id @default(cuid())
  entryId     String
  componentId String? // links to SalaryComponent
  type        PayrollLineItemType
  name        String // snapshot label at time of calculation
  amount      Decimal
  notes       String?

  entry     PayrollEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  component SalaryComponent? @relation(fields: [componentId], references: [id])

  @@map("payroll_line_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// STATUTORY RULES (Phase 31)
// ─────────────────────────────────────────────────────────────────────────────

// Country-agnostic statutory rule configuration
model StatutoryRule {
  id            String    @id @default(cuid())
  tenantId      String
  countryCode   String // "IN", "US", "UK"
  name          String // "PF Employee", "ESI Employer", "PT Karnataka"
  code          String // "PF_EMP", "ESI_EMP", "PT_KA"
  type          String // "PERCENTAGE_OF_COMPONENT" | "FIXED_SLAB" | "CUSTOM_FORMULA"
  baseComponent String? // component code used as base (e.g. "BASIC")
  rateOrAmount  Decimal
  cappedAt      Decimal? // earnings cap above which rule doesn't apply
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("statutory_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// POLICIES (Phase 26)
// ─────────────────────────────────────────────────────────────────────────────

model PolicyCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  policies Policy[]

  @@unique([tenantId, name])
  @@map("policy_categories")
}

model Policy {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String
  title       String
  description String?
  isPublished Boolean  @default(false)
  requiresAck Boolean  @default(false) // Requires employee acknowledgement
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  category PolicyCategory  @relation(fields: [categoryId], references: [id])
  versions PolicyVersion[]

  @@map("policies")
}

model PolicyVersion {
  id            String    @id @default(cuid())
  tenantId      String
  policyId      String
  versionNumber Int
  blocks        Json // Stores the rich blocks array
  status        String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  policy           Policy                  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  publisher        User?                   @relation("PolicyPublisher", fields: [publishedById], references: [id])
  acknowledgements PolicyAcknowledgement[]

  @@unique([policyId, versionNumber])
  @@map("policy_versions")
}

model PolicyAcknowledgement {
  id              String    @id @default(cuid())
  tenantId        String
  policyVersionId String
  employeeId      String
  status          String    @default("PENDING") // PENDING, ACKNOWLEDGED
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, employeeId])
  @@map("policy_acknowledgements")
}

enum LibraryItemType {
  FILE
  ARTICLE
  ANNOUNCEMENT
}

model LibraryFolder {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  parentId  String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  parent   LibraryFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children LibraryFolder[] @relation("FolderHierarchy")
  items    LibraryItem[]
  creator  User            @relation(fields: [createdBy], references: [id])

  @@index([tenantId, parentId])
  @@map("library_folders")
}

model LibraryItem {
  id        String          @id @default(uuid())
  tenantId  String
  folderId  String?
  type      LibraryItemType
  title     String
  content   String?
  fileUrl   String?
  fileKey   String?
  mimeType  String?
  sizeBytes Int?
  tags      String[]
  isPinned    Boolean         @default(false)
  pinnedUntil DateTime?
  isArchived  Boolean         @default(false)
  createdBy   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  folder  LibraryFolder? @relation(fields: [folderId], references: [id])
  creator User           @relation(fields: [createdBy], references: [id])

  @@index([tenantId, type])
  @@index([tenantId, isPinned])
  @@index([tenantId, folderId])
  @@map("library_items")
}

model SavedReport {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  dataset      String
  config       Json
  isScheduled  Boolean  @default(false)
  cronSchedule String?
  emails       String?
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("saved_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYROLL SETTINGS (Phase 32)
// ─────────────────────────────────────────────────────────────────────────────

model PayrollSettings {
  id                             String  @id @default(cuid())
  tenantId                       String  @unique
  companyLogoUrl                 String?
  authorizedSignatoryName        String?
  authorizedSignatoryDesignation String?
  themeColor                     String  @default("#000000")
  customMessage                  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("payroll_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROJECTS & BUDGET MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

model CostCenter {
  id          String  @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  parentId    String?
  managerId   String? // Employee ID
  isActive    Boolean @default(true)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  parent         CostCenter?     @relation("CostCenterHierarchy", fields: [parentId], references: [id])
  children       CostCenter[]    @relation("CostCenterHierarchy")
  budgetRequests BudgetRequest[]
  projects       Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@map("cost_centers")
}

model BudgetCategory {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  parentId    String?
  capexOpex   CapexOpex @default(OPEX)
  isActive    Boolean   @default(true)

  tenant       Tenant                  @relation(fields: [tenantId], references: [id])
  parent       BudgetCategory?         @relation("BudgetCategoryHierarchy", fields: [parentId], references: [id])
  children     BudgetCategory[]        @relation("BudgetCategoryHierarchy")
  requestLines BudgetRequestLineItem[]
  allocations  BudgetAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@map("budget_categories")
}

model BudgetPeriod {
  id        String   @id @default(cuid())
  tenantId  String
  name      String // "FY26-27"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(true)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  budgetRequests BudgetRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("budget_periods")
}

model Project {
  id             String          @id @default(cuid())
  tenantId       String
  code           String
  name           String
  description    String?
  managerId      String? // Employee ID
  departmentId   String?
  costCenterId   String?
  client         String?
  startDate      DateTime?       @db.Date
  plannedEndDate DateTime?       @db.Date
  actualEndDate  DateTime?       @db.Date
  status         ProjectStatus   @default(PLANNING)
  priority       ProjectPriority @default(MEDIUM)

  // Snapshots computed from transactions
  approvedBudget       Decimal @default(0)
  currentBudget        Decimal @default(0)
  actualCost           Decimal @default(0)
  committedCost        Decimal @default(0)
  availableBudget      Decimal @default(0)
  completionPercentage Int     @default(0)

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  costCenter      CostCenter?         @relation(fields: [costCenterId], references: [id])
  budgetRequests  BudgetRequest[]
  members         ProjectMember[]
  milestones      ProjectMilestone[]
  transactions    BudgetTransaction[]
  allocations     BudgetAllocation[]
  commitments     BudgetCommitment[]
  expenses        ProjectExpense[]
  fundingReleases FundingRelease[]
  revisions       BudgetRevision[]
  forecasts       ProjectForecast[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("projects")
}

model ProjectMember {
  id            String    @id @default(cuid())
  projectId     String
  employeeId    String
  role          String
  allocationPct Int       @default(100)
  startDate     DateTime? @db.Date
  endDate       DateTime? @db.Date
  billingRate   Decimal?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, employeeId])
  @@map("project_members")
}

model ProjectMilestone {
  id            String          @id @default(cuid())
  projectId     String
  name          String
  description   String?
  ownerId       String?
  plannedStart  DateTime?       @db.Date
  plannedEnd    DateTime?       @db.Date
  actualStart   DateTime?       @db.Date
  actualEnd     DateTime?       @db.Date
  status        MilestoneStatus @default(NOT_STARTED)
  completionPct Int             @default(0)

  plannedBudget Decimal @default(0)
  actualCost    Decimal @default(0)

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocations BudgetAllocation[]
  expenses    ProjectExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_milestones")
}

model BudgetRequest {
  id            String  @id @default(cuid())
  tenantId      String
  requestNumber String
  requesterId   String // Employee ID
  departmentId  String?
  costCenterId  String?
  projectId     String?
  periodId      String?

  requestType String
  priority    ProjectPriority     @default(MEDIUM)
  status      BudgetRequestStatus @default(DRAFT)

  // Justification
  objective             String?
  businessJustification String?
  expectedOutcomes      String?
  risks                 String?
  dependencies          String?

  // Financial Summary
  requestedAmount Decimal @default(0)
  currency        String  @default("INR")
  exchangeRate    Decimal @default(1.0)

  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  project          Project?                @relation(fields: [projectId], references: [id])
  costCenter       CostCenter?             @relation(fields: [costCenterId], references: [id])
  period           BudgetPeriod?           @relation(fields: [periodId], references: [id])
  lineItems        BudgetRequestLineItem[]
  workflowInstance WorkflowInstance?
  isArchived       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, requestNumber])
  @@map("budget_requests")
}

model BudgetRequestLineItem {
  id              String    @id @default(cuid())
  budgetRequestId String
  categoryId      String?
  description     String
  quantity        Decimal   @default(1)
  unitCost        Decimal   @default(0)
  requestedAmount Decimal   @default(0)
  capexOpex       CapexOpex @default(OPEX)

  request  BudgetRequest   @relation(fields: [budgetRequestId], references: [id], onDelete: Cascade)
  category BudgetCategory? @relation(fields: [categoryId], references: [id])

  @@map("budget_request_lines")
}

// Immutable ledger for all financial movements
model BudgetTransaction {
  id              String                @id @default(cuid())
  tenantId        String
  projectId       String
  type            BudgetTransactionType
  amount          Decimal
  currency        String                @default("INR")
  transactionDate DateTime              @default(now())

  // References to source documents
  referenceType String? // "EXPENSE", "FUNDING_RELEASE", "REVISION", "REALLOCATION"
  referenceId   String?

  description String?
  createdBy   String // User ID

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId, projectId])
  @@index([tenantId, type])
  @@map("budget_transactions")
}

model BudgetAllocation {
  id          String  @id @default(cuid())
  projectId   String
  categoryId  String?
  milestoneId String?
  amount      Decimal
  currency    String  @default("INR")

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  BudgetCategory?   @relation(fields: [categoryId], references: [id])
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budget_allocations")
}

model BudgetCommitment {
  id            String  @id @default(cuid())
  projectId     String
  amount        Decimal
  currency      String  @default("INR")
  referenceType String // "PURCHASE_ORDER", "CONTRACT"
  referenceId   String
  description   String?
  status        String  @default("OPEN") // OPEN, FULFILLED, CANCELLED

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budget_commitments")
}

model ProjectExpense {
  id          String  @id @default(cuid())
  tenantId    String
  projectId   String
  milestoneId String?
  employeeId  String // Submitter
  categoryId  String?

  amount      Decimal
  currency    String   @default("INR")
  date        DateTime @db.Date
  description String?
  receiptUrl  String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAID

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, projectId])
  @@map("project_expenses")
}

model FundingRelease {
  id              String               @id @default(cuid())
  projectId       String
  amountRequested Decimal
  amountReleased  Decimal              @default(0)
  status          FundingReleaseStatus @default(REQUESTED)
  reason          String?
  requestedById   String
  approvedById    String?
  releaseDate     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("funding_releases")
}

model BudgetRevision {
  id              String    @id @default(cuid())
  projectId       String
  previousAmount  Decimal
  requestedAmount Decimal
  revisedAmount   Decimal?
  reason          String
  status          String    @default("PENDING")
  requestedById   String
  approvedById    String?
  approvalDate    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budget_revisions")
}

model BudgetReallocation {
  id              String    @id @default(cuid())
  fromProjectId   String
  toProjectId     String
  fromCategoryId  String?
  toCategoryId    String?
  fromMilestoneId String?
  toMilestoneId   String?
  amount          Decimal
  reason          String
  status          String    @default("PENDING")
  requestedById   String
  approvedById    String?
  approvalDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budget_reallocations")
}

model ProjectForecast {
  id                     String   @id @default(cuid())
  projectId              String
  forecastDate           DateTime @default(now())
  actualCost             Decimal
  committedCost          Decimal
  estimatedRemainingCost Decimal
  estimateAtCompletion   Decimal
  forecastVariance       Decimal
  notes                  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("project_forecasts")
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 22: API & INTEGRATIONS
// ─────────────────────────────────────────────────────────────────────────────

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model ApiKey {
  id          String       @id @default(cuid())
  tenantId    String
  name        String                         // "Payroll Integration", etc.
  keyHash     String       @unique           // bcrypt/SHA-256 hash of actual key
  keyPrefix   String                         // first 8 chars for display (km_live_xxxx)
  scopes      String[]                       // ["employees:read","payroll:read"]
  status      ApiKeyStatus @default(ACTIVE)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdByUserId String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  createdBy   User         @relation(fields: [createdByUserId], references: [id])
  auditLogs   ApiKeyAuditLog[]

  @@index([tenantId])
  @@map("api_keys")
}

model ApiKeyAuditLog {
  id        String   @id @default(cuid())
  apiKeyId  String
  action    String   // "CREATED" | "REVOKED" | "USED"
  ipAddress String?
  userAgent String?
  endpoint  String?
  createdAt DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@map("api_key_audit_logs")
}

enum WebhookEventType {
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  EMPLOYEE_OFFBOARDED
  LEAVE_APPROVED
  LEAVE_REJECTED
  PAYROLL_FINALIZED
  ATTENDANCE_MARKED
  RESIGNATION_SUBMITTED
  CUSTOM
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

model WebhookEndpoint {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  url       String
  secret    String  // HMAC signing secret (stored encrypted)
  events    WebhookEventType[]
  isActive  Boolean @default(true)
  headers   Json    @default("{}")  // custom headers

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id              String                @id @default(cuid())
  endpointId      String
  event           WebhookEventType
  payload         Json
  status          WebhookDeliveryStatus @default(PENDING)
  responseStatus  Int?
  responseBody    String?
  attemptCount    Int                   @default(0)
  nextRetryAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, status])
  @@map("webhook_deliveries")
}

enum IntegrationProvider {
  GOOGLE_WORKSPACE
  MICROSOFT_365
  SLACK
  TEAMS
  GREYTHR          // payroll
  KEKA             // payroll
  TALLY            // accounting
  QUICKBOOKS       // accounting
  ZOHO_BOOKS       // accounting
  BIOMETRIC_ZKTIME // attendance device
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING_OAUTH
}

model TenantIntegration {
  id           String              @id @default(cuid())
  tenantId     String
  provider     IntegrationProvider
  status       IntegrationStatus   @default(DISCONNECTED)
  config       Json                @default("{}")  // encrypted at app layer
  accessToken  String?             // encrypted
  refreshToken String?             // encrypted
  tokenExpiry  DateTime?
  metadata     Json                @default("{}")  // scopes, user info, etc.
  lastSyncAt   DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("tenant_integrations")
}

model EncryptedSecret {
  id        String   @id @default(cuid())
  tenantId  String
  key       String   // e.g. "google_oauth_token", "webhook_secret_123"
  value     String   // The AES-256-GCM encrypted value
  iv        String   // Initialization vector
  authTag   String   // Authentication tag

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("encrypted_secrets")
}

// ─────────────────────────────────────────────────────────────────────────────
// SAAS BILLING (Phase 24)
// ─────────────────────────────────────────────────────────────────────────────

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

// Plan definitions — editable by Super Admin
model PlanDefinition {
  id                    String     @id @default(cuid())
  name                  String     @unique // "Free" | "Starter" | "Growth" | "Enterprise"
  slug                  TenantPlan @unique // maps to TenantPlan enum
  description           String?
  monthlyPriceInr       Decimal    @default(0) @db.Decimal(10, 2)
  monthlyPriceUsd       Decimal    @default(0) @db.Decimal(10, 2)
  annualDiscountPct     Int        @default(16) // % off annual vs 12x monthly
  maxEmployees          Int? // null = unlimited
  maxStorageMb          Int? // null = unlimited
  maxApiCallsPerMonth   Int? // null = unlimited
  employeeOverageRateInr Decimal?  @db.Decimal(10, 2)
  employeeOverageRateUsd Decimal?  @db.Decimal(10, 2)
  trialDays             Int        @default(14)
  isPublic              Boolean    @default(true)
  razorpayMonthlyPlanId String? // Razorpay Plan ID for monthly billing
  razorpayAnnualPlanId  String? // Razorpay Plan ID for annual billing
  modules               Json       @default("[]") // string[] of enabled module keys
  sortOrder             Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions TenantSubscription[]

  @@map("plan_definitions")
}

// Individual module add-ons — prices editable by Super Admin
model ModuleAddon {
  id                    String  @id @default(cuid())
  key                   String  @unique // "payroll" | "ai" | "projects" | etc.
  name                  String
  description           String?
  monthlyPriceInr       Decimal @db.Decimal(10, 2)
  monthlyPriceUsd       Decimal @db.Decimal(10, 2)
  razorpayMonthlyPlanId String?
  isActive              Boolean @default(true)
  sortOrder             Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionAddons TenantSubscriptionAddon[]

  @@map("module_addons")
}

// One subscription per tenant
model TenantSubscription {
  id                     String             @id @default(cuid())
  tenantId               String             @unique
  planId                 String
  billingCycle           BillingCycle       @default(MONTHLY)
  status                 SubscriptionStatus @default(TRIALING)
  currency               String             @default("INR") // "INR" | "USD"
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)

  // Razorpay references
  razorpaySubscriptionId String?
  razorpayCustomerId     String?
  razorpayPlanId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  plan         PlanDefinition            @relation(fields: [planId], references: [id])
  addons       TenantSubscriptionAddon[]
  invoices     Invoice[]
  usageRecords UsageRecord[]

  @@map("tenant_subscriptions")
}

// Junction: which add-ons are active on a subscription
model TenantSubscriptionAddon {
  id             String   @id @default(cuid())
  subscriptionId String
  addonId        String
  quantity       Int      @default(1)
  addedAt        DateTime @default(now())

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon        ModuleAddon        @relation(fields: [addonId], references: [id])

  @@unique([subscriptionId, addonId])
  @@map("tenant_subscription_addons")
}

// Invoices (auto-generated monthly or on one-time add-on purchase)
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  subscriptionId String?
  invoiceNumber  String        @unique // e.g. "KM-2026-0001"
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime
  paidAt         DateTime?

  // Razorpay
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpayPaymentUrl String? // short payment link for self-serve

  lineItems Json // [{description: string, quantity: number, unitPrice: number, amount: number}]
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  subscription TenantSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, status])
  @@map("invoices")
}

// Usage metering records (written by nightly cron job)
model UsageRecord {
  id             String   @id @default(cuid())
  tenantId       String
  subscriptionId String?
  metric         String // "employees" | "storage_mb" | "api_calls"
  value          Int
  recordedAt     DateTime @default(now())
  periodStart    DateTime
  periodEnd      DateTime

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  subscription TenantSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, metric, recordedAt])
  @@map("usage_records")
}
